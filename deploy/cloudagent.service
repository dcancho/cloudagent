[Unit]
Description=CloudAgent host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudagent
Group=cloudagent
WorkingDirectory=/opt/cloudagent/current
EnvironmentFile=/etc/cloudagent/cloudagent.env
Environment=HOME=/var/lib/cloudagent
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
ExecStart=/opt/cloudagent/current/CloudAgent.Host
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
MemoryMax=3G

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/cloudagent

[Install]
WantedBy=multi-user.target
