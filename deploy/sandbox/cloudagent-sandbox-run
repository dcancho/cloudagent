#!/usr/bin/env bash
# The only way the host starts a sandbox container. Installed as /usr/local/bin/cloudagent-sandbox-run and
# run by the service user through sudo as cloudagent-sandbox. Every input is validated here; the docker
# command line is built here, so a caller can choose a task, a repository and an image from the allowlists
# and a command to run inside, and nothing else.
#
#   cloudagent-sandbox-run run --task ID --repo NAME --image IMAGE [--memory 2g] [--cpus 1.5]
#                              [--workdir /work/sub] [--env NAME=VALUE]... -- PROGRAM [ARGS...]
#   cloudagent-sandbox-run kill --task ID
#
# DRY_RUN=1 prints the docker command instead of running it, and reads the allowlists from
# SANDBOX_CONFIG_DIR (default /etc/cloudagent).
set -euo pipefail
umask 077
PATH=/usr/bin:/bin

config_dir=/etc/cloudagent
if [ "${DRY_RUN:-}" = 1 ]; then
    config_dir="${SANDBOX_CONFIG_DIR:-/etc/cloudagent}"
fi
repos_file="$config_dir/sandbox-repos"
images_file="$config_dir/sandbox-images"

network=cloudagent-sandbox-internal
proxy=http://cloudagent-egress:3128
no_proxy=localhost,127.0.0.1
name_prefix=cloudagent-sbx-
mount_point=/work
container_user=1000:1000
pids_limit=512
allowed_env=(CI GIT_PAGER GIT_TERMINAL_PROMPT MSBUILDDISABLENODEREUSE PAGER TERM)

die() {
    echo "cloudagent-sandbox-run: $*" >&2
    exit 2
}

valid_task() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]{2,39}$ ]]
}

# Prints the value after the first "key=" line of an allowlist file whose key is exactly $2.
lookup() {
    local file="$1" key="$2" k v
    [ -r "$file" ] || return 1
    while IFS='=' read -r k v || [ -n "$k" ]; do
        case "$k" in '' | '#'*) continue ;; esac
        if [ "$k" = "$key" ]; then
            printf '%s\n' "$v"
            return 0
        fi
    done < "$file"
    return 1
}

listed() {
    local file="$1" item="$2" line
    [ -r "$file" ] || return 1
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in '' | '#'*) continue ;; esac
        [ "$line" = "$item" ] && return 0
    done < "$file"
    return 1
}

[ "$#" -ge 1 ] || die "usage: run|kill ..."
mode="$1"
shift

task="" repo="" image="" memory=2g cpus=1.5 workdir="$mount_point"
caller_env=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --task | --repo | --image | --memory | --cpus | --workdir | --env)
            [ "$#" -ge 2 ] || die "$1 needs a value"
            case "$1" in
                --task) task="$2" ;;
                --repo) repo="$2" ;;
                --image) image="$2" ;;
                --memory) memory="$2" ;;
                --cpus) cpus="$2" ;;
                --workdir) workdir="$2" ;;
                --env) caller_env+=("$2") ;;
            esac
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *) die "unknown argument: $1" ;;
    esac
done

valid_task "$task" || die "invalid task id"
name="$name_prefix$task"

rootless_environment() {
    [ "$(id -u)" -ne 0 ] || die "refusing to run as root"
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export DOCKER_HOST="unix://$XDG_RUNTIME_DIR/docker.sock"
}

case "$mode" in
    kill)
        [ "$#" -eq 0 ] || die "kill takes no command"
        if [ "${DRY_RUN:-}" = 1 ]; then
            echo "docker kill $name"
            exit 0
        fi
        rootless_environment
        exec /usr/bin/docker kill "$name"
        ;;
    run) ;;
    *) die "unknown mode: $mode" ;;
esac

[[ "$repo" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "invalid repository name"
task_dir="$(lookup "$repos_file" "$repo")" || die "repository not allowed: $repo"
[[ "$task_dir" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "invalid directory for repository: $repo"
case "$task_dir/" in */../* | */./*) die "invalid directory for repository: $repo" ;; esac

[[ "$image" =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]{0,200}$ ]] || die "invalid image name"
listed "$images_file" "$image" || die "image not allowed: $image"

[[ "$memory" =~ ^[1-9][0-9]{0,3}[mg]$ ]] || die "invalid memory limit"
[[ "$cpus" =~ ^[0-9]{1,2}(\.[0-9]{1,2})?$ ]] || die "invalid cpu limit"
[[ "$workdir" =~ ^/work(/[A-Za-z0-9._-]+)*$ ]] || die "invalid working directory"
case "$workdir/" in */../* | */./*) die "invalid working directory" ;; esac

for entry in "${caller_env[@]}"; do
    var_name="${entry%%=*}"
    var_value="${entry#*=}"
    [ "$var_name" != "$entry" ] || die "invalid environment entry"
    ok=0
    for allowed in "${allowed_env[@]}"; do
        [ "$var_name" = "$allowed" ] && ok=1
    done
    [ "$ok" -eq 1 ] || die "environment variable not allowed: $var_name"
    [[ "$var_value" =~ ^[A-Za-z0-9._:/,@+=-]*$ ]] || die "invalid value for $var_name"
done

[ "$#" -ge 1 ] || die "no command given"
program="$1"
[[ "$program" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || die "invalid program name"

cmd=(
    run --rm --pull never
    --name "$name"
    --network "$network"
    --cap-drop=ALL
    --security-opt no-new-privileges
    --pids-limit "$pids_limit"
    --memory "$memory"
    --cpus "$cpus"
    --read-only
    --tmpfs /tmp:rw,exec,nosuid,size=512m
    --user "$container_user"
    -v "$task_dir:$mount_point:rw"
    -w "$workdir"
    -e HOME=/tmp
    -e DOTNET_CLI_HOME=/tmp
    -e NUGET_PACKAGES=/tmp/.nuget/packages
    -e DOTNET_CLI_TELEMETRY_OPTOUT=1
    -e DOTNET_NOLOGO=1
    -e DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
    -e "HTTP_PROXY=$proxy"
    -e "HTTPS_PROXY=$proxy"
    -e "NO_PROXY=$no_proxy"
    -e "http_proxy=$proxy"
    -e "https_proxy=$proxy"
    -e "no_proxy=$no_proxy"
)
for entry in "${caller_env[@]}"; do
    cmd+=(-e "$entry")
done
cmd+=("$image" "$@")

if [ "${DRY_RUN:-}" = 1 ]; then
    printf 'docker'
    printf ' %s' "${cmd[@]}"
    printf '\n'
    exit 0
fi

[ -d "$task_dir" ] || die "directory missing for repository: $repo"
rootless_environment
exec /usr/bin/docker "${cmd[@]}"
