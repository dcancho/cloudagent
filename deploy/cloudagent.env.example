# Installed at /etc/cloudagent/cloudagent.env (root:cloudagent, 0640). One KEY=value per line, no quotes.

# LLM (Foundry)
FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/models
FOUNDRY_API_KEY=<foundry-api-key>
FOUNDRY_MODEL=<main-deployment-name>
FOUNDRY_EMBED_MODEL=<embedding-deployment-name>
AGENT_SMALL_MODEL=<background-deployment-name>
# FOUNDRY_DECISIONS_ENDPOINT=https://<resource>.services.ai.azure.com/providers/microsoft/v1/systemone
# DECISIONS_MODEL=<decision-deployment-name>

# Surfaces
DISCORD_BOT_TOKEN=<discord-bot-token>
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
WEBCHAT=1
WEBCHAT_PORT=5080
WEBCHAT_ANONYMOUS=0
# No terminal under systemd
CLI=0

# Data
AGENT_WORKSPACE=/var/lib/cloudagent/workspace
PEOPLE_FILE=/var/lib/cloudagent/people.json
PERSONAL_MEMORY_DIR=/var/lib/cloudagent/memory/people

# Tokens, input and output together, before the agents stop
TOKEN_BUDGET=<token-limit>

# Dollars per million tokens, input/output, per model name as used in requests; only the usage report reads it
# MODEL_PRICES=<main-deployment-name>=<input>/<output>;<background-deployment-name>=<input>/<output>

# Web search (optional, remove the line to run without)
TAVILY_API_KEY=<tavily-api-key>

# CODE_REPOS is deliberately unset: the pilot cannot run commands on the server.
# Once deploy/sandbox is set up (docs/deploy.md), commands run in a container:
# SANDBOX_RUNNER=/usr/local/bin/cloudagent-sandbox-run
# SANDBOX_IMAGE=cloudagent-sandbox-dotnet:latest
